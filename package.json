{
  "name": "dn-orbit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "next dev --no-server-fast-refresh",
    "build": "prisma generate && ([ \"$VERCEL_ENV\" != production ] || prisma migrate deploy) && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "scrape:club-events": "bun run scripts/scrapeClubEvents.ts",
    "setup:supabase": "bun run scripts/setupSupabaseBucket.ts",
    "seed:demo": "bun run scripts/seedDemoContent.ts",
    "test": "bun test lib",
    "test:api": "node scripts/test-api.mjs",
    "test:api:auth": "node scripts/test-api.mjs",
    "test:api:base": "node scripts/test-api.mjs --base-url=http://localhost:3000",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lenis": "~1.3.26",
    "lucide-react": "^1.18.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.20.0",
    "react": "^19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.0.2",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prisma": "^7.5.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
