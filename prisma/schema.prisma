// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  president
  vice_president
  core_member
  member
  // Former DevNation members who have graduated. No admin access; recognised so
  // they can be showcased and addressed distinctly. See lib/roles.ts.
  alumni
  // Non-DevNation AJIET students: no club membership and no admin access, but
  // recognised so AJIET-only events can identify them. See lib/roles.ts.
  ajiet_student
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ProjectStatus {
  planning
  active
  completed
  stalled
}

enum EventAudience {
  members
  college
  // Open to DevNation members (via account) OR AJIET students (via USN), but
  // not the general public.
  members_college
  public
}

// ─────────────────────────────────────────────
// USERS — central hub
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  githubId        String    @unique @map("github_id")
  githubUsername  String    @unique @map("github_username")
  email           String    @unique
  name            String
  /// Auth.js profile image (`avatar_url` in DB)
  image           String?   @map("avatar_url")
  emailVerified   DateTime? @map("email_verified")
  role            Role      @default(ajiet_student)
  status          ApprovalStatus @default(pending)

  // Onboarding fields
  lcUsername      String?  @map("lc_username")
  branch          String?
  year            Int?
  usn             String?
  bio             String?
  isVisible       Boolean  @default(true) @map("is_visible")

  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  accounts          Account[]
  sessions          Session[]
  githubStats       GithubStats[]
  lcStats           LcStats[]
  leaderboardScore  LeaderboardScore?
  createdEvents     Event[]           @relation("EventCreator")
  reviewedEvents    Event[]           @relation("EventReviewer")
  registrations     Registration[]
  feedback          Feedback[]
  ledProjects       Project[]         @relation("ProjectLead")
  reviewedProjects  Project[]         @relation("ProjectReviewer")
  projectMemberships ProjectMember[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ALLOWLIST — admin-controlled club membership gate
// ─────────────────────────────────────────────
// Only GitHub users whose login or email appears here (or in the
// ADMIN_GITHUB_USERNAMES env bootstrap list) may complete sign-in. The public
// can browse the site without an account; sign-in is reserved for club members.

model Allowlist {
  id             String   @id @default(uuid())
  githubUsername String?  @unique @map("github_username")
  email          String?  @unique
  note           String?
  addedBy        String?  @map("added_by") // user id of the admin who added it
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("allowlist")
}

// ─────────────────────────────────────────────
// NEXTAUTH ACCOUNTS
// ─────────────────────────────────────────────

model Account {
  id                 String  @id @default(uuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ─────────────────────────────────────────────
// NEXTAUTH SESSIONS
// ─────────────────────────────────────────────

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────
// GITHUB STATS
// ─────────────────────────────────────────────

model GithubStats {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  reposCount   Int      @default(0) @map("repos_count")
  totalCommits Int      @default(0) @map("total_commits")
  totalPrs     Int      @default(0) @map("total_prs")
  totalStars   Int      @default(0) @map("total_stars")
  // Merged PRs to public repos the user does NOT own, where the upstream repo
  // has at least ScoreWeight.ghOpenSourceMinStars stars — i.e. real open-source
  // contributions. Feeds the GitHub component of the leaderboard score.
  openSourcePrs Int     @default(0) @map("open_source_prs")
  topLanguages Json     @default("[]") @map("top_languages") // string[]
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("github_stats")
}

// ─────────────────────────────────────────────
// LEETCODE STATS
// ─────────────────────────────────────────────

model LcStats {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  totalSolved  Int      @default(0) @map("total_solved")
  easySolved   Int      @default(0) @map("easy_solved")
  mediumSolved Int      @default(0) @map("medium_solved")
  hardSolved   Int      @default(0) @map("hard_solved")
  lcRanking    Int?     @map("lc_ranking")
  streak       Int      @default(0)
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lc_stats")
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

model Event {
  id          String   @id @default(uuid())
  createdBy   String   @map("created_by")
  title       String
  description String?
  bannerUrl   String?  @map("banner_url")
  eventType   String?  @map("event_type")
  eventDate   DateTime @map("event_date")
  location    String?
  isPublished          Boolean       @default(false) @map("is_published")
  reviewStatus         ApprovalStatus @default(pending) @map("review_status")
  reviewedById         String?        @map("reviewed_by")
  reviewedAt           DateTime?      @map("reviewed_at")
  audience             EventAudience @default(public)
  capacity             Int?
  registrationDeadline DateTime?     @map("registration_deadline")
  formSchema           Json?         @map("form_schema")
  createdAt            DateTime      @default(now()) @map("created_at")

  creator       User           @relation("EventCreator", fields: [createdBy], references: [id])
  reviewedBy    User?          @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  registrations Registration[]
  feedback      Feedback[]

  @@map("events")
}

// ─────────────────────────────────────────────
// REGISTRATIONS (User <-> Event junction)
// ─────────────────────────────────────────────

model Registration {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  eventId      String   @map("event_id")
  name         String
  email        String
  usn          String?
  responses    Json     @default("{}")
  attended     Boolean  @default(false)
  registeredAt DateTime @default(now()) @map("registered_at")

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@map("registrations")
}

// ─────────────────────────────────────────────
// FEEDBACK
// ─────────────────────────────────────────────

model Feedback {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  eventId     String   @map("event_id")
  rating      Int      // 1–5
  comments    String?
  submittedAt DateTime @default(now()) @map("submitted_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId]) // one feedback per user per event
  @@map("feedback")
}

// ─────────────────────────────────────────────
// LEADERBOARD SCORES (computed, stored nightly)
// ─────────────────────────────────────────────

model LeaderboardScore {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  githubScore Float    @default(0) @map("github_score")
  lcScore     Float    @default(0) @map("lc_score")
  eventScore  Float    @default(0) @map("event_score")
  totalScore  Float    @default(0) @map("total_score")
  rank        Int?
  computedAt  DateTime @default(now()) @map("computed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard_scores")
}

// ─────────────────────────────────────────────
// SCORE WEIGHTS (admin-configurable)
// ─────────────────────────────────────────────

model ScoreWeight {
  id            String   @id @default(uuid())
  githubWeight  Float    @default(0.33) @map("github_weight")
  lcWeight      Float    @default(0.33) @map("lc_weight")
  eventWeight   Float    @default(0.34) @map("event_weight")
  // Open-source contribution tuning (part of the GitHub component, not a
  // top-level weight). minStars is applied at fetch time when counting a
  // member's qualifying merged PRs; perPrPoints is applied at score time.
  ghOpenSourceMinStars    Int   @default(10) @map("gh_open_source_min_stars")
  ghOpenSourcePerPrPoints Float @default(10) @map("gh_open_source_per_pr_points")
  updatedBy     String?  @map("updated_by") // user id of last admin to change it
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("score_weights")
}

// ─────────────────────────────────────────────
// AUDIT LOG (system activity feed)
// ─────────────────────────────────────────────
// Append-only record of every meaningful mutation across the app (events,
// projects, registrations, allowlist, roles, weights, …). actorName is
// denormalised so the log line survives the actor being deleted. Indexed on
// createdAt so the dashboard can pull the newest N cheaply even at high volume.

model AuditLog {
  id        String   @id @default(uuid())
  action    String // machine tag, e.g. "event.create"
  actorId   String?  @map("actor_id") // user id, null for anonymous/public actors
  actorName String?  @map("actor_name") // denormalised display name
  summary   String // human-readable line shown in the feed
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────

model Project {
  id            String        @id @default(uuid())
  leadId        String        @map("lead_id")
  title         String
  description   String?
  imageUrl      String?       @map("image_url")
  status        ProjectStatus @default(planning)
  progressPct   Int           @default(0) @map("progress_pct") // 0–100
  githubRepoUrl String?       @map("github_repo_url")
  demoUrl       String?       @map("demo_url")
  techStack     Json          @default("[]") @map("tech_stack")  // string[]
  milestones    Json          @default("[]") // { label: string, done: boolean }[]
  reviewStatus  ApprovalStatus @default(pending) @map("review_status")
  reviewedById  String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  submittedAt   DateTime      @default(now()) @map("submitted_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  lead       User            @relation("ProjectLead", fields: [leadId], references: [id])
  reviewedBy User?           @relation("ProjectReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  members    ProjectMember[]

  @@map("projects")
}

// ─────────────────────────────────────────────
// PROJECT MEMBERS (User <-> Project junction)
// ─────────────────────────────────────────────

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String?  // e.g. "frontend", "backend", "ml", "lead"
  joinedAt  DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId]) // one membership per user per project
  @@map("project_members")
}
