# Neon DB
DATABASE_URL=
DIRECT_URL=

NEON_API_KEY=
# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Membership gate — comma-separated GitHub usernames that are always allowed to
# sign in AND are granted the admin role on first sign-in. This is how the first
# admin gets in before the allowlist / admin UI exist. At least one is required,
# otherwise nobody can sign in. Everyone else must be added to the allowlist by
# an admin (Admin → Members → ACCESS_ALLOWLIST).
ADMIN_GITHUB_USERNAMES=

# Supabase Storage — `media` bucket (event & project images, folders events/ projects/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service) key — server-side uploads only. NEVER expose to the client.
SUPABASE_PRIVATE_KEY=
