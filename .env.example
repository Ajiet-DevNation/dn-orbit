# Neon DB
DATABASE_URL=
DIRECT_URL=

NEON_API_KEY=
# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap — SEED-TIME ONLY (never read at runtime). Comma-separated
# GitHub usernames that `bunx prisma db seed` writes into the DB allowlist with
# grantRole=president, so the first admin of a fresh deploy can sign in before
# any admin UI exists. After seeding, roles live entirely in the DB and are
# managed from Admin → Members; everyone else must be added to the allowlist
# there (Admin → Members → ACCESS_ALLOWLIST).
ADMIN_GITHUB_USERNAMES=

# Supabase Storage — `media` bucket (event & project images, folders events/ projects/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service) key — server-side uploads only. NEVER expose to the client.
SUPABASE_PRIVATE_KEY=

# GitHub org webhook — shared secret for /api/webhooks/github.
#
# A push or PR by a member marks their stats for priority refresh, so the
# leaderboard reflects real activity within seconds instead of waiting out a
# poll interval. Without this the board still works, it just refreshes purely on
# the staleness timer.
#
# Setup (once, by a GitHub org admin):
#   GitHub org -> Settings -> Webhooks -> Add webhook
#   Payload URL:  https://<your-site>/api/webhooks/github
#   Content type: application/json
#   Secret:       the same value you set here (generate: openssl rand -hex 32)
#   Events:       Pushes, Pull requests, Branch or tag creation
#
# The route FAILS CLOSED if this is unset — deliveries are rejected with 401
# rather than trusted, so a missing env var can never make the endpoint public.
GITHUB_WEBHOOK_SECRET=

# How stale a member's cached stats may get before a visit triggers a refresh.
# Defaults are 30 min (GitHub) and 60 min (LeetCode); see lib/sync-queue.ts.
