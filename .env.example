# Neon DB
DATABASE_URL=
DIRECT_URL=

NEON_API_KEY=
# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Membership gate — comma-separated GitHub usernames that are always allowed to
# sign in AND are granted the admin role on first sign-in. This is how the first
# admin gets in before the allowlist / admin UI exist. At least one is required,
# otherwise nobody can sign in. Everyone else must be added to the allowlist by
# an admin (Admin → Members → ACCESS_ALLOWLIST).
ADMIN_GITHUB_USERNAMES=

# Supabase Storage (event banners)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key — server-side admin uploads only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Public storage bucket name for event banners
SUPABASE_BANNERS_BUCKET=event-banners