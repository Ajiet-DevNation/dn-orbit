# Neon DB
DATABASE_URL=
DIRECT_URL=

NEON_API_KEY=
# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin bootstrap — SEED-TIME ONLY (never read at runtime). Comma-separated
# GitHub usernames that `bunx prisma db seed` writes into the DB allowlist with
# grantRole=president, so the first admin of a fresh deploy can sign in before
# any admin UI exists. After seeding, roles live entirely in the DB and are
# managed from Admin → Members; everyone else must be added to the allowlist
# there (Admin → Members → ACCESS_ALLOWLIST).
ADMIN_GITHUB_USERNAMES=

# Supabase Storage — `media` bucket (event & project images, folders events/ projects/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service) key — server-side uploads only. NEVER expose to the client.
SUPABASE_PRIVATE_KEY=
